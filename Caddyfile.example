# Example Caddyfile for SiteSnap with automatic HTTPS.
#
# 1. Install Caddy on the host (https://caddyserver.com/docs/install).
# 2. Point your domain's DNS A/AAAA record at this server.
# 3. Copy this file to /etc/caddy/Caddyfile and edit the domain.
# 4. sudo systemctl reload caddy
#
# Caddy will obtain and renew Let's Encrypt certificates automatically.
# HTTPS is required for: PWA install, camera access, service worker, Web Speech API.

survey.example.com {
	encode zstd gzip

	# Optional: tighten upload limits for photos/audio.
	request_body {
		max_size 100MB
	}

	reverse_proxy localhost:8000
}
