# SiteSnap environment configuration.
# Copy to config/.env (or set in docker-compose.yml) and edit before first run.

# ---- Auth ----
# argon2 hash of your PIN. Generate with:
#   python -m backend.scripts.hash_pin
# (or) docker compose run --rm sitesnap python -m backend.scripts.hash_pin
# Paste the resulting $argon2... string here.
# IMPORTANT: Escape every $ as $$ for docker compose, e.g.:
#   $$argon2id$$v=19$$m=65536,t=3,p=4$$abc$$def
SITESNAP_PIN_HASH=

# Random 32+ char secret for signing JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# JWT lifetime in days.
JWT_TTL_DAYS=30

# ---- Whisper transcription ----
# faster-whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=small
# Device: cuda (GPU) or cpu
WHISPER_DEVICE=cuda
# Compute type: default keeps faster-whisper defaults per device.
# For cuda try "int8_float16"; for cpu use "int8".
WHISPER_COMPUTE_TYPE=

# ---- Storage ----
# Absolute or container-relative path for SQLite db, images, audio.
DATA_DIR=/app/data

# ---- Server ----
# Bind host/port inside the container.
HOST=0.0.0.0
PORT=8000
# Number of uvicorn workers. Keep 1: in-process transcription queue + SQLite.
WORKERS=1

# ---- Misc ----
# Optional: brand color (hex) used for image overlay bars and PDF accents.
BRAND_COLOR=#0B1F3A
# CORS allowed origin. Leave blank to allow same-origin only (recommended).
CORS_ORIGIN=
